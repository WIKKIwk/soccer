# Local PostgreSQL connection contract. Replace placeholders locally; never commit credentials.
DATABASE_URL=postgres://<app_user>:<app_password>@127.0.0.1:5432/<football_database>?application_name=football-platform
# Optional local admin API bind address; defaults to 127.0.0.1:3000.
ADMIN_API_BIND_ADDR=127.0.0.1:3000
# Structured log filter; defaults to info.
RUST_LOG=info
# Integration tests only; use a separate approved disposable database.
TEST_DATABASE_URL=postgres://<test_user>:<test_password>@127.0.0.1:5432/<football_test_database>?application_name=football-platform-tests
